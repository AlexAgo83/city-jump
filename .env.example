# Copy to .env and fill in. .env is never versioned.
#
# Render static site, used by scripts that inspect a deploy's outcome.
# The API key is a bearer token: keep it out of commands, logs and messages.

RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx
RENDER_SITE_URL=https://your-site.onrender.com
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
