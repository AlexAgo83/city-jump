{
  "name": "city-jump",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run typecheck",
    "preview": "vite preview",
    "test": "vitest run",
    "test:architecture": "node --test tests/architecture.mjs",
    "test:e2e": "node scripts/with-dev-server.mjs scripts/interact.mjs",
    "test:visual": "node scripts/with-dev-server.mjs scripts/shot.mjs",
    "typecheck": "tsc",
    "lint": "npm run typecheck",
    "logics:validate": "logics-manager lint --require-status && logics-manager audit --group-by-doc",
    "ci": "npm test && npm run test:architecture && npm run build && npm run test:e2e && npm run logics:validate",
    "verify": "npm run test:visual",
    "check": "npm run test:e2e"
  },
  "keywords": [
    "city-builder",
    "babylonjs",
    "simulation"
  ],
  "author": "Alexandre Agostini",
  "license": "MIT",
  "description": "A browser-based 3D city builder where roads shape the city.",
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@babylonjs/core": "^9.22.2",
    "@babylonjs/loaders": "^9.22.2"
  },
  "type": "module"
}
