{
  "name": "city-jump",
  "version": "0.2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run typecheck",
    "preview": "vite preview",
    "test": "vitest run",
    "test:architecture": "node --test tests/*.mjs",
    "test:e2e": "node scripts/with-dev-server.mjs scripts/interact.mjs",
    "test:visual": "node scripts/with-dev-server.mjs scripts/shot.mjs",
    "typecheck": "tsc",
    "lint": "npm run typecheck",
    "logics:validate": "logics-manager lint --require-status && logics-manager audit --group-by-doc",
    "ci": "npm test && npm run test:architecture && npm run build && npm run logics:validate",
    "release:static": "npm run ci",
    "verify": "npm run test:visual",
    "check": "npm run test:e2e"
  },
  "keywords": [
    "city-builder",
    "city-simulation",
    "urban-planning",
    "road-network",
    "traffic-simulation",
    "procedural-generation",
    "babylonjs",
    "typescript",
    "webgl"
  ],
  "author": "Alexandre Agostini",
  "homepage": "https://city-jump.onrender.com/",
  "license": "MIT",
  "description": "A browser-based 3D city builder where roads, terrain, buildings, and traffic derive from a playable road graph.",
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@babylonjs/core": "^9.22.2",
    "@babylonjs/loaders": "^9.22.2"
  },
  "type": "module"
}
