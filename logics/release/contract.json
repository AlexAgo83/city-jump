{
  "schema_version": "1.0",
  "project": {
    "id": "city-jump",
    "display_name": "City Jump",
    "release_profile": "discovered-local"
  },
  "version_sources": [
    {
      "path": "package.json",
      "format": "json",
      "selector": "version",
      "required": true
    },
    {
      "path": "package-lock.json",
      "format": "json",
      "selector": "version",
      "required": true
    }
  ],
  "changelog": {
    "required": true,
    "version_heading_required": true,
    "paths": [
      {
        "path": "changelogs/CHANGELOGS_{version_underscore}.md",
        "format": "markdown",
        "required": true
      }
    ]
  },
  "operator_intents": [
    {
      "utterance": "prepare release",
      "boundary": "Prepare metadata and changelog only. Do not tag, push, publish, upload assets, or create a GitHub release unless explicitly requested. Do not record gate evidence yet: evidence is anchored to the release commit, which resolves to the tag, and the tag does not exist during preparation.",
      "publication_action": false
    },
    {
      "utterance": "commit and push, fix if CI is not green",
      "boundary": "Push first, then inspect the real remote CI run for the exact pushed commit before making fixes.",
      "publication_action": false
    },
    {
      "utterance": "publish release",
      "boundary": "Publish only after required local and remote gates are green, then verify downstream publication or deployment evidence.",
      "publication_action": true
    },
    {
      "utterance": "tag the release",
      "boundary": "Tag only after the pushed commit is green in CI, then record every gate's evidence against that tagged commit in one pass. Recording evidence before the tag exists anchors it to a moving HEAD and each later evidence commit invalidates it.",
      "publication_action": false
    }
  ],
  "missing_contract_discovery": {
    "draft_path": {
      "path": "logics/release/contract.draft.json",
      "format": "json",
      "required": false
    },
    "local_first": true,
    "neighbor_projects_allowed": true,
    "local_sources": [
      {
        "path": "LOGICS.md",
        "required": false
      },
      {
        "path": "README.md",
        "required": false
      },
      {
        "path": "package.json",
        "required": false
      },
      {
        "path": "pyproject.toml",
        "required": false
      },
      {
        "path": ".github/workflows/",
        "required": false
      },
      {
        "path": "changelogs/",
        "required": false
      },
      {
        "path": "VERSION",
        "required": false
      },
      {
        "path": "checksums/",
        "required": false
      }
    ],
    "assistant_rule": "Infer this draft from local repository signals first. Use neighboring projects only as comparison evidence after local surfaces have been inspected."
  },
  "state_machine": [
    "planning",
    "preparing",
    "local_validation",
    "commit_ready",
    "pushed",
    "ci_verification",
    "github_release",
    "external_publication",
    "ready",
    "blocked"
  ],
  "gates": [
    {
      "id": "version_metadata",
      "state": "preparing",
      "required": true,
      "evidence_kinds": [
        "file"
      ],
      "comparison": "release"
    },
    {
      "id": "changelog",
      "state": "preparing",
      "required": true,
      "evidence_kinds": [
        "file"
      ],
      "comparison": "release"
    },
    {
      "id": "local_validation",
      "state": "local_validation",
      "required": true,
      "evidence_kinds": [
        "command"
      ],
      "comparison": "release"
    },
    {
      "id": "git_push",
      "state": "pushed",
      "required": true,
      "evidence_kinds": [
        "git"
      ],
      "comparison": "release"
    },
    {
      "id": "ci",
      "state": "ci_verification",
      "required": true,
      "evidence_kinds": [
        "ci"
      ],
      "comparison": "release"
    },
    {
      "id": "github_release",
      "state": "github_release",
      "required": true,
      "evidence_kinds": [
        "github_release"
      ],
      "comparison": "release"
    },
    {
      "id": "npm_package",
      "state": "external_publication",
      "required": false,
      "evidence_kinds": [
        "external"
      ],
      "comparison": "release"
    },
    {
      "id": "production_deployment",
      "state": "external_publication",
      "required": true,
      "evidence_kinds": [
        "external"
      ],
      "comparison": "release"
    }
  ],
  "evidence": {
    "store": {
      "path": "logics/release/evidence.jsonl",
      "format": "jsonl",
      "required": true
    },
    "freshness": {
      "match_target_version": true,
      "match_commit_for_source_gates": true,
      "match_tag_for_publication_gates": true
    },
    "required_fields": [
      "kind",
      "status",
      "observed_at",
      "target_version",
      "commit",
      "summary"
    ]
  },
  "validation_commands": [
    {
      "id": "ci",
      "command": [
        "npm",
        "run",
        "ci"
      ],
      "required": true,
      "evidence_kind": "command"
    },
    {
      "id": "e2e",
      "command": [
        "npm",
        "run",
        "test:e2e"
      ],
      "required": true,
      "evidence_kind": "command",
      "description": "Browser interaction suite. Not run by GitHub Actions, so it only ever passes locally."
    }
  ],
  "git": {
    "release_branch_policy": "main_only",
    "allowed_branches": [
      "main"
    ],
    "tag_policy": {
      "required": true,
      "pattern": "v{version}",
      "anchors_evidence": true
    },
    "require_clean_worktree": true,
    "require_pushed_commit": true
  },
  "github_release": {
    "required": true,
    "mode": "manual",
    "draft_allowed": false,
    "asset_paths": []
  },
  "assistant_readiness": {
    "must_inspect_status_before_claiming_ready": true,
    "readiness_source": "project_owned_evidence",
    "publication_requires_explicit_operator_approval": true
  },
  "external_publication": [
    {
      "id": "npm_package",
      "kind": "package_registry",
      "required": false,
      "url_template": "https://www.npmjs.com/package/city-jump/v/{version}"
    },
    {
      "id": "production_deployment",
      "kind": "deployment",
      "required": true,
      "description": "Verify the production deployment for the target commit and version."
    }
  ],
  "release_sequence": [
    "Bump the version sources and stamp README, SECURITY and docs; npm run check:versions.",
    "Write changelogs/CHANGELOGS_{version_underscore}.md and link it from changelogs/README.md.",
    "Run npm run ci and npm run test:e2e locally.",
    "Commit the preparation. This commit is the release commit.",
    "Push it and wait for the GitHub Actions CI run on that exact commit.",
    "Tag it v{version}, once CI is green.",
    "Record version_metadata, changelog, local_validation, git_push and ci in one pass, every entry carrying the tagged commit. Commit and push that evidence.",
    "Publish the GitHub release, which triggers the Render deployment.",
    "Verify the public site serves the new version, then record github_release and production_deployment. The site sits behind a cache: sample it more than once."
  ]
}
